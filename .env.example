# Production API Backend URL (Set this in Vercel Environment Variables)
# Example: https://ai-career-planner-3mxx.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Express Proxy Server Root URL (Optional, auto-derived from VITE_API_URL if omitted)
# Example: https://ai-career-planner-3mxx.onrender.com
VITE_PROXY_SERVER_URL=http://localhost:5000

# Firebase Client Configuration (Optional)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
